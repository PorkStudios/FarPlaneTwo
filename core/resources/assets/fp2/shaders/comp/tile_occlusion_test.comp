#define min4(a0, a1, a2, a3) (min(min(min(a0, a1), a2), a3))
#define max4(a0, a1, a2, a3) (max(max(max(a0, a1), a2), a3))
#define min8(a0, a1, a2, a3, a4, a5, a6, a7) (min(min(min(min(min(min(min(a0, a1), a2), a3), a4), a5), a6), a7))
#define max8(a0, a1, a2, a3, a4, a5, a6, a7) (max(max(max(max(max(max(max(a0, a1), a2), a3), a4), a5), a6), a7))

const bool REVERSEDZ = bool(FP2_REVERSEDZ);
const bool AUTO_REDUCE = bool(FP2_AUTO_REDUCE);

uniform sampler2D u_depthTexture;

layout(std140) readonly restrict buffer B_TilePositions {
    ivec4 b_tilePositions[];
};

